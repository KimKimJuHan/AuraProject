# ── 필수 (없으면 서버가 시작되지 않음) ──────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
SESSION_SECRET=change-me
JWT_SECRET=change-me

# ── 서비스 URL ──────────────────────────────────────────────────
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── 소셜 로그인 (선택) ──────────────────────────────────────────
STEAM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 데이터 수집 (선택) ──────────────────────────────────────────
ITAD_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=

# ── 알림 (선택) ─────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
